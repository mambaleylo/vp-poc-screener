<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/bg" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="12dp" android:paddingBottom="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="VP-POC · связка" android:textColor="#8B96A5" android:textSize="12sp" />
        <TextView android:id="@+id/upd" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="—" android:textColor="#8B96A5" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:layout_marginTop="2dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Баланс" android:textColor="#8B96A5" android:textSize="11sp" />
            <TextView android:id="@+id/bal" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" android:singleLine="true" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
            android:gravity="right">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="через год, если как сейчас" android:textColor="#8B96A5" android:textSize="11sp" />
            <TextView android:id="@+id/year" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textColor="#4ADE80" android:textSize="24sp" android:textStyle="bold" android:singleLine="true" />
            <TextView android:id="@+id/mult" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#86EFAC" android:textSize="12sp" android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/chart" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:minHeight="36dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:scaleType="fitXY" />
    <TextView android:id="@+id/mods" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textColor="#C9D1D9" android:textSize="11sp" android:maxLines="2" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/line" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="нажмите, чтобы обновить" android:textColor="#8B96A5" android:textSize="11sp" android:singleLine="true" />
        <TextView android:id="@+id/warn" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="#FBBF24" android:textSize="11sp" android:singleLine="true" android:layout_marginLeft="6dp" />
    </LinearLayout>
</LinearLayout>
