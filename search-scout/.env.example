# Скопируйте этот файл в .env и заполните. Файл .env не попадает в git.

# --- Telegram ---
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш Telegram user ID (несколько — через запятую). Пусто = бот никого не пускает.
ALLOWED_USER_IDS=

# --- Режим работы ---
# auto — Live, если заданы ключи Wordstat, иначе Demo; demo — только CSV; live — только Wordstat
SCOUT_MODE=auto

# --- Yandex Wordstat (Yandex Cloud Search API v2) ---
# API-ключ сервисного аккаунта (роль search-api.webSearch.user, scope yc.search-api.execute)
WORDSTAT_API_KEY=
# ID каталога Yandex Cloud
WORDSTAT_FOLDER_ID=
# ID регионов Wordstat через запятую. Пусто = все регионы. 225 — Россия, 149 — Беларусь, 159 — Казахстан
WORDSTAT_REGIONS=
# Устройства: пусто = все; иначе desktop,phone,tablet
WORDSTAT_DEVICES=
# Сколько запросов к API можно потратить за одно сканирование
WORDSTAT_MAX_REQUESTS_PER_SCAN=60
# Из них — на запросы динамики
WORDSTAT_DYNAMICS_PER_SCAN=15
# Максимум запросов в секунду
WORDSTAT_RPS=2

# --- CSV ---
# Файл, который импортируется при каждом сканировании (пусто = не импортировать)
CSV_IMPORT_PATH=data/demo_keywords.csv
# true — данные в файле тестовые (демо); false — реальные (например, ручная выгрузка)
CSV_IS_DEMO=true

# --- Ежедневный отчёт ---
TIMEZONE=Europe/Moscow
DAILY_TIME=09:00
DAILY_DEFAULT_ENABLED=true

# --- Прочее ---
DATABASE_PATH=data/search_scout.sqlite3
LOG_LEVEL=INFO

# Адрес собственного Bot API сервера (обычно не нужен)
TELEGRAM_API_BASE=
